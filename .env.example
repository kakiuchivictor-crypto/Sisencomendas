# =============================================================================
# Copie este arquivo para .env.local e preencha com os valores reais.
# .env.local NUNCA e versionado (ver .gitignore).
# =============================================================================

# --- Banco (queries de negocio, via withTenantContext / role sisencomendas_app) ---
# Em producao e no dev, aponta para o Postgres do projeto Supabase real
# (pooler, porta 6543 - transaction mode).
DATABASE_URL="postgres://sisencomendas_app:SUA_SENHA@HOST.pooler.supabase.com:6543/postgres"

# --- Supabase Auth (login via signInWithPassword) ---
# Project Settings > API. Independente de DATABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Sensivel: bypassa RLS. So usar em codigo server-side (ex: criar usuarios via
# Admin API). Nunca expor ao client.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Conexoes privilegiadas / one-off (opcionais) ---
# Superuser do Postgres do Supabase. Use apenas para DDL/migrations manuais e
# reconhecimento pontual. NUNCA como DATABASE_URL da aplicacao.
SUPABASE_DB_URL=""

# --- Legado: Postgres local (nao usado pela aplicacao apos a migracao) ---
# Mantidos so para rodar pnpm db:seed / db:migrate contra o Postgres local.
LOCAL_DATABASE_URL="postgres://sisencomendas_app:SUA_SENHA@127.0.0.1:5432/sisencomendas_dev"
MIGRATION_DATABASE_URL="postgres://sisencomendas_owner:SUA_SENHA@127.0.0.1:5432/sisencomendas_dev"
